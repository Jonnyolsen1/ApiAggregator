{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Providers": {
    "GitHub":         {"BaseUrl": "https://api.github.com/" },
    "NewsApi":        {"BaseUrl": "https://newsapi.org/",              "ApiKey": ""},
    "OpenWeatherMap": {"BaseUrl": "https://api.openweathermap.org/",  "ApiKey": ""}
  },
  "Cache": {
    "FreshMinutes": 5,
    "StaleMinutes": 60
  },
  "Statistics": {
    "FastThresholdMs": 100,
    "SlowThresholdMs": 200
  }
}
